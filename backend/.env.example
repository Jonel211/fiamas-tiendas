# FIAMAS BACKEND - CONFIGURACIÓN DE ENTORNO

# SERVIDOR
PORT=3000
NODE_ENV=development

# BASE DE DATOS POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fiamas_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# JWT - AUTENTICACIÓN
# Generar una clave secreta segura para producción (ej: openssl rand -base64 32)
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_cambiar_en_produccion
JWT_EXPIRE=7d


# FRONTEND / CORS
FRONTEND_URL=http://localhost:5173

# SINCRONIZACIÓN DE BASE DE DATOS
# true: ejecuta alter: true en arranque (desarrollo). false: recomendado para producción
DB_SYNC_ALTER=true